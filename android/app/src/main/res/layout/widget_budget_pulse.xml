<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_default"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: Label + Privacy Eye + Quick Add Expense -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_budget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Safe / day"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_privacy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Toggle privacy"
            android:padding="3dp"
            android:src="@drawable/ic_widget_eye" />

        <ImageView
            android:id="@+id/btn_quick_expense"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_btn_gold"
            android:contentDescription="Add expense"
            android:padding="4dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- Main Hero Value -->
    <LinearLayout
        android:id="@+id/budget_body_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_safe_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rp 250.000"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_budget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Budget left: Rp 2.500.000"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Color-coded Progress Bars (only one visible at a time) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp">

        <ProgressBar
            android:id="@+id/progress_ok"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="45"
            android:progressDrawable="@drawable/widget_progress_ok" />

        <ProgressBar
            android:id="@+id/progress_warn"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="85"
            android:progressDrawable="@drawable/widget_progress_warn"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_over"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/widget_progress_over"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Footer: Days Remaining -->
    <TextView
        android:id="@+id/txt_days_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="12 days left"
        android:textColor="#FFD4AF37"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
